# Auth - generate with: openssl rand -base64 32
AUTH_SECRET=

# The canonical URL of your deployment (required for NextAuth callbacks in production)
AUTH_URL=http://localhost:3000/api/auth

# WebAuthn - set to your domain for production
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Database path (defaults to ./dev-hub.db)
DB_PATH=./dev-hub.db

# Chat input autocomplete (→ to accept). Can also be turned off in Settings → General. Uses any OpenAI-compatible endpoint.
# Defaults to OpenRouter with the key from `opencode auth login openrouter`.
# CHAT_SUGGEST_DISABLED=true
# CHAT_SUGGEST_BASE_URL=https://openrouter.ai/api/v1
# CHAT_SUGGEST_API_KEY=
# CHAT_SUGGEST_MODEL=openai/gpt-oss-120b
