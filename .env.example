# Auth - generate with: openssl rand -base64 32
AUTH_SECRET=

# The canonical URL of your deployment (required for NextAuth callbacks in production)
AUTH_URL=http://localhost:3000/api/auth

# WebAuthn - set to your domain for production
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Database path (defaults to ./dev-hub.db)
DB_PATH=./dev-hub.db

# Chat input autocomplete (Tab to accept). Can also be turned off in Settings → General. Uses any OpenAI-compatible endpoint.
# Defaults to OpenRouter with the key from `opencode auth login openrouter`.
# CHAT_SUGGEST_DISABLED=true
# CHAT_SUGGEST_BASE_URL=https://openrouter.ai/api/v1
# CHAT_SUGGEST_API_KEY=
# CHAT_SUGGEST_MODEL=openai/gpt-oss-120b

# OmO Native engine (optional)
# Path to the omo binary (defaults to `omo` on PATH)
# OMO_BIN=omo
# omo agent dir holding the daemon socket (defaults to ~/.omo/agent)
# OMO_CODING_AGENT_DIR=
# Close the idle RPC connection after this many ms (the daemon keeps running)
# OMO_IDLE_DISCONNECT_MS=
# Bearer token for devhub-agent omo routes on remote workspaces
# DEVHUB_AGENT_TOKEN=
# Comma-separated list of exact origins (e.g. https://agent.example.com:7500) allowed to receive DEVHUB_AGENT_TOKEN besides loopback
# DEVHUB_AGENT_ALLOWED_ORIGINS=
